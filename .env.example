DATABASE_URL=postgresql+asyncpg://nexus:local-development-only@127.0.0.1:55432/nexus
# Generate a private workspace token using: openssl rand -hex 32
NEXUS_API_TOKEN=
NEXUS_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
# Explicit provider credentials/model IDs; leave blank until configured.
OPENAI_API_KEY=
NEXUS_PLANNER_MODEL=
ANTHROPIC_API_KEY=
NEXUS_CLAUDE_MODEL=
NEXUS_CODEX_MODEL=
GEMINI_API_KEY=
NEXUS_GEMINI_MODEL=
KIMI_API_KEY=
NEXUS_KIMI_MODEL=
MANUS_API_KEY=
NEXUS_WORKSPACE_ROOT=.data/workspaces
NEXUS_ARTIFACT_ROOT=.data/artifacts
NEXUS_CHECKPOINT_PATH=.data/checkpoints.db
NEXUS_WORKER_IMAGE=nexus-worker:local
NEXUS_SANDBOX_NETWORK=nexus-sandbox
NEXUS_API_RATE_LIMIT=600
NEXUS_DAILY_DISPATCH_MICROUSD=50000000
# Optional S3-compatible storage. Use standard AWS_* environment credentials.
NEXUS_S3_BUCKET=
NEXUS_S3_ENDPOINT=
# Optional signed n8n intake.
NEXUS_N8N_SECRET=
NEXUS_AUTOMATION_WORKSPACE_ID=
# Optional Manus receipt verification; canonical public URL and cached PEM key.
NEXUS_MANUS_PUBLIC_KEY=
NEXUS_MANUS_CALLBACK_URL=
# Next.js server configuration, never NEXT_PUBLIC provider credentials.
NEXUS_API_URL=http://127.0.0.1:8110
NEXUS_WEB_ORIGIN=
